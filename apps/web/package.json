{
  "name": "dynamic-procurement-workbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "NODE_EXTRA_CA_CERTS=./certs/supabase-prod-ca-2021.crt next dev",
    "build": "next build --webpack",
    "start": "NODE_EXTRA_CA_CERTS=./certs/supabase-prod-ca-2021.crt next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test": "node --experimental-transform-types --test tests/*.test.ts"
  },
  "dependencies": {
    "lucide-react": "^1.59.0",
    "next": "16.4.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "react-grab": "^0.2.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "zod": "4.6.5"
  }
}
